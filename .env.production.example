# Copy to .env on the server (chmod 600). Never commit the real file.
# Generate the secrets ON THE SERVER, see deploy/README.md step "secrets";
# they never go through chat or git.

# PostgreSQL runs in the `db` container; compose.yaml sets the URL and user.
MOS_DB_PASSWORD=

# Signs dashboard and app sign-in tokens (at least 32 characters).
MOS_JWT_SECRET=

# Used once, by the one-off demo seed (admin@mos.test / staff@mos.test).
MOS_DEMO_ADMIN_PASSWORD=
MOS_DEMO_STAFF_PASSWORD=

# Browser origins allowed to call /api/app (Flutter web). The phone app is not
# a browser and needs nothing here; the default covers `flutter run -d chrome`.
MOS_CORS_APP_ORIGINS=http://localhost:*,http://127.0.0.1:*
