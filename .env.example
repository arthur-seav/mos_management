# Copy this file to .env (same folder as pom.xml) and fill in the values.
# .env is git-ignored. Spring Boot reads it on start (spring.config.import).

# PostgreSQL started with the docker command in README.md
MOS_DB_URL=jdbc:postgresql://127.0.0.1:54322/mos
MOS_DB_USER=mos
MOS_DB_PASSWORD=

# Signs the sign-in tokens. Any random string of 32+ characters, e.g.
#   openssl rand -base64 48
MOS_JWT_SECRET=

# Optional demo bootstrap passwords; no built-in or shared default passwords.
# Start once with --mos.demo.seed=true on an EMPTY database, then omit that flag.
MOS_DEMO_ADMIN_PASSWORD=
MOS_DEMO_STAFF_PASSWORD=
# The current payment implementation is simulated in all modes.
